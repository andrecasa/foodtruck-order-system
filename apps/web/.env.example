# ===================================================
# App Web (Vite) — ONDE FICAM AS VARIÁVEIS
# ===================================================
# ATENÇÃO: este pacote NÃO usa um .env próprio.
# apps/web/vite.config.ts define:  envDir = '../..'
# Ou seja, o Vite lê as variáveis VITE_* do .env DA RAIZ do monorepo.
#
# Configure as VITE_* no arquivo:  <raiz>/.env
#   VITE_API_URL=http://localhost:4000
#   VITE_SUPABASE_URL=http://localhost:8000
#   VITE_SUPABASE_ANON_KEY=<anon-key>   # igual ao SUPABASE_ANON_KEY da infra
#   # VITE_THEME_CONFIG_PATH=           # opcional (não usado hoje)
#
# Ver <raiz>/.env.example para o conjunto completo.
# ===================================================
