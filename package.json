{
  "name": "order-system",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Sistema de pedidos para food truck",
  "scripts": {
    "dev:backend": "pnpm --filter @order-system/backend dev",
    "dev:web": "pnpm --filter @order-system/web dev",
    "dev:mobile": "pnpm --filter @order-system/mobile start",
    "build:pwa": "pnpm --filter @order-system/mobile pwa",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8"
  }
}
