{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "paths": {
      "@order-system/shared": ["../../packages/shared/src"],
      "@order-system/shared/*": ["../../packages/shared/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/__tests__"],
  "references": [
    { "path": "../../packages/shared" }
  ]
}
