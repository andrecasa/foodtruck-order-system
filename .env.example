# ===================================================
# Order System - Variáveis de Ambiente
# ===================================================
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
# ===================================================

# --- Supabase (Self-Hosted) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.example
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.example
JWT_SECRET=super-secret-jwt-token-change-in-production
JWT_EXPIRY=28800

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=order_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL alternativo (se definido, tem precedência sobre as vars individuais)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_system

# --- Backend ---
BACKEND_PORT=4000
NODE_ENV=development

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
# Nome da instância Evolution padrão/de plataforma (genérico).
# Cada Tenant tem sua própria instância registrada em tenants.evolution_instance_name.
EVOLUTION_INSTANCE_NAME=default-instance

# --- App Web (Vite) ---
# Prefixo VITE_ expõe variáveis ao browser via import.meta.env
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.example
# Path para JSON de tema customizado (build-time, opcional)
# VITE_THEME_CONFIG_PATH=

# --- App Mobile (Expo) ---
# Prefixo EXPO_PUBLIC_ expõe variáveis ao app via process.env
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.example
# JSON string com config de tema (mobile, opcional)
# EXPO_PUBLIC_THEME_CONFIG=

# --- URLs de acesso ---
API_URL=http://localhost:4000
REALTIME_URL=ws://localhost:8000/realtime/v1
SITE_URL=http://localhost:3000

# --- Kong (API Gateway) ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# --- Supabase Auth (GoTrue) ---
GOTRUE_PORT=9999
API_EXTERNAL_URL=http://localhost:8000
DISABLE_SIGNUP=false
ADDITIONAL_REDIRECT_URLS=

# --- Supabase Realtime ---
REALTIME_PORT=4001
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# --- Theme / White Label ---
# Path para JSON de tema (backend/scripts, opcional)
# THEME_CONFIG_PATH=

# --- Admin inicial (bootstrap do primeiro tenant) ---
# Credenciais genéricas do admin provisionado por ./scripts/seed-first-tenant.sh
# (que roda o onboarding: cria o tenant + admin no Auth + linha em `users`).
# Sem nome, marca ou domínio de um Tenant específico — ajuste no deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# --- Deploy / Domínio ---
# Domínio público da plataforma (genérico/parametrizável, sem marca de cliente).
DEPLOY_DOMAIN=localhost

# --- Timezone ---
TZ=America/Sao_Paulo
