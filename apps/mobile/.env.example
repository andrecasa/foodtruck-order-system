# ===================================================
# App Mobile / PWA (Expo) - .env — EXEMPLO
# ===================================================
# Copie para apps/mobile/.env:  cp .env.example .env
#
# CONSUMIDO POR: expo (start/export), que roda a partir de apps/mobile.
# Só variáveis com prefixo EXPO_PUBLIC_ são embutidas no bundle do app.
#
# IMPORTANTE:
#   - Estas variáveis NÃO são lidas do .env da raiz do monorepo.
#   - Ao rodar no navegador/dispositivo, aponte para um host acessível a partir
#     dele (ex.: o IP da sua máquina na rede, não "localhost", se testar de
#     outro aparelho).
#   - EXPO_PUBLIC_SUPABASE_ANON_KEY deve ser o MESMO valor do SUPABASE_ANON_KEY
#     usado pela infra (.env da raiz), senão a API/Realtime rejeita o app.
#   - São embutidas no bundle após rebuild (não são segredos de servidor).
# ===================================================

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# JSON string com config de tema (opcional)
# EXPO_PUBLIC_THEME_CONFIG=
