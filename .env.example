# ===================================================
# Order System - .env (RAIZ) — EXEMPLO
# ===================================================
# Copie para .env e ajuste:  cp .env.example .env
#
# CONSUMIDO POR:
#   - Docker Compose (infra: Postgres, GoTrue, Realtime, Kong, Evolution)
#   - Backend (apps/backend, via process.env)
#   - Scripts (scripts/*.sh)
#   - App WEB (Vite): apps/web/vite.config.ts usa envDir='../..', então o Vite
#     lê as VITE_* DESTE arquivo (raiz).
#
# App mobile / PWA (Expo) → apps/mobile/.env (EXPO_PUBLIC_*), NÃO este arquivo.
# ===================================================

# --- Supabase (Self-Hosted) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
JWT_SECRET=super-secret-jwt-token-change-in-production
JWT_EXPIRY=28800

# --- App Web (Vite) — lidas pelo apps/web via envDir='../..' ---
# VITE_SUPABASE_ANON_KEY DEVE ser igual ao SUPABASE_ANON_KEY acima.
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=<anon-key>
# VITE_THEME_CONFIG_PATH=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=order_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL alternativo (se definido, tem precedência sobre as vars individuais)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_system

# --- Backend ---
BACKEND_PORT=4000
NODE_ENV=development

# --- Assets S3 (logomarcas dos tenants) — R14.1/R14.2/R8.1 ---
# Bucket S3 onde as logomarcas são gravadas (chave tenant-assets/{slug}/logo.{ext}).
# Buckets por ambiente (mesma conta AWS), ambos com LEITURA PÚBLICA:
#   - Produção: order-system-assets-<accountId>       (Terraform, infra/s3.tf)
#   - Dev:      order-system-assets-<accountId>-dev    (AWS CLI, fora do IaC)
# Upload: produção usa o IAM role da EC2 (sem credenciais em env); em dev use
# um usuário IAM dedicado (ex.: order-system-dev-assets) com policy restrita
# APENAS a este bucket -dev (menor privilégio). Nunca use chaves de admin.
ASSETS_S3_BUCKET=order-system-assets
# URL base pública das imagens (LEITURA). A Logo_Public_Url é derivada como
# {ASSETS_PUBLIC_BASE_URL}/tenant-assets/{slug}/logo.{ext}. Como o bucket tem
# leitura pública, a leitura é feita DIRETO do S3 em ambos os ambientes:
#   - Produção: https://order-system-assets-<accountId>.s3.<region>.amazonaws.com
#   - Dev:      https://order-system-assets-<accountId>-dev.s3.<region>.amazonaws.com
ASSETS_PUBLIC_BASE_URL=https://order-system-assets-<accountId>-dev.s3.us-east-1.amazonaws.com
# Região do Assets_Bucket (padrão us-east-1).
AWS_REGION=us-east-1
# Credenciais AWS — APENAS desenvolvimento local (rodando fora da EC2, não há
# IAM role). Em produção NÃO defina estas: o SDK usa o IAM role da instância.
# São secretas — preencha só no seu .env (git-ignored), nunca versione valores reais.
# AWS_ACCESS_KEY_ID=<access-key-do-usuario-dev-dedicado>
# AWS_SECRET_ACCESS_KEY=<secret-do-usuario-dev-dedicado>

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=<evolution-api-key>
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=default-instance

# --- Supabase Auth (GoTrue) ---
GOTRUE_PORT=9999
API_EXTERNAL_URL=http://localhost:8000
DISABLE_SIGNUP=false
ADDITIONAL_REDIRECT_URLS=
SITE_URL=http://localhost:3000

# --- Kong (API Gateway) ---
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# --- Supabase Realtime ---
REALTIME_PORT=4001
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_SECRET_KEY_BASE=<realtime-secret-key-base>

# --- Admin inicial (seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# --- Timezone ---
TZ=America/Sao_Paulo

# --- Entrega de e-mail (SMTP) ---
# Seleciona o provedor de e-mail transacional (recuperação de senha, etc.).
# Valores aceitos:
#   noop     → descarta a mensagem (padrão; usado quando ausente ou vazio)
#   logging  → apenas registra a mensagem em log (não entrega)
#   smtp     → entrega de verdade via servidor SMTP (usa as variáveis SMTP_* abaixo)
EMAIL_PROVIDER=noop

# Configuração SMTP — obrigatória SOMENTE quando EMAIL_PROVIDER=smtp.
# Se EMAIL_PROVIDER=smtp e qualquer obrigatória estiver ausente/inválida,
# o backend falha ao subir (fail-fast). NUNCA versione credenciais reais.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=<remetente@example.com>
# SMTP_SECURE: true → TLS implícito (porta 465); false → STARTTLS (porta 587, padrão)
SMTP_SECURE=false

# Exemplo de referência — Gmail com Senha de App (2FA habilitado na conta).
# Use SOMENTE como referência; preencha com seus próprios dados no .env (sem versionar):
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=<sua-conta@gmail.com>
#   SMTP_PASS=<senha-de-app-de-16-caracteres>
#   SMTP_FROM=<sua-conta@gmail.com>
#   SMTP_SECURE=false
