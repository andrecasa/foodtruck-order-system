# ===================================================
# App Web (Vite) - .env — EXEMPLO
# ===================================================
# Copie para apps/web/.env:  cp .env.example .env
#
# CONSUMIDO POR: Vite (dev/build), que roda a partir de apps/web.
# Só variáveis com prefixo VITE_ são expostas ao browser via import.meta.env.
#
# IMPORTANTE:
#   - Estas variáveis NÃO são lidas do .env da raiz do monorepo.
#   - O app tem FALLBACKS embutidos (localhost:4000 / localhost:8000), então
#     roda sem este arquivo. Crie-o apenas para apontar para outro host/anon key.
#   - VITE_SUPABASE_ANON_KEY deve ser o MESMO do SUPABASE_ANON_KEY da infra.
# ===================================================

# VITE_API_URL=http://localhost:4000
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=<anon-key>

# Path para JSON de tema customizado (build-time, opcional)
# VITE_THEME_CONFIG_PATH=
