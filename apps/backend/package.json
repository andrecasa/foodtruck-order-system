{
  "name": "@order-system/backend",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=../../.env src/db/run-migrations.ts",
    "migrate:validate": "tsx --env-file=../../.env src/db/validate-schema.ts",
    "create-tenant": "tsx --env-file=../../.env scripts/create-tenant.ts",
    "provision-pastel": "tsx --env-file=../../.env scripts/provision-pastel-das-meninas.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@order-system/shared": "workspace:*",
    "@supabase/supabase-js": "2.47.12",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "express": "4.21.2",
    "express-rate-limit": "^8.6.2",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.11",
    "fast-check": "^4.9.0",
    "tsx": "4.19.2",
    "typescript": "6.0.3",
    "vitest": "2.1.8"
  }
}
